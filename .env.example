# ---------- 运行环境 ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# 生产填 PostgreSQL 连接串；留空则用内置 SQLite（仅适合单副本开发）
DATABASE_URL=
SQLITE_FILE=./data/claw.db
PG_POOL_MAX=20

# 多副本共享限流；留空则进程内内存限流
REDIS_URL=

# 必改：JWT 签名密钥（生产请用 32 位以上随机串）
JWT_SECRET=please-change-me-to-a-long-random-string

# 管理员初始账号（首次 seed 时创建）
ADMIN_PHONE=13354281998
ADMIN_PASSWORD=sangjiexun@2026
ADMIN_NAME=桑杰逊

# 跨域白名单，默认 * （仅建议开发环境）
CORS_ORIGINS=*
TRUST_PROXY=true

# 限流
RATE_LIMIT_MAX=180
RATE_LIMIT_WINDOW_MS=60000
